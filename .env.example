# ==========================================
# LuxeStay Backend Environment Variables
# ==========================================

# Server Port (for local Node.js development)
PORT=5000

# MongoDB Connection URI (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/luxestay?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for authenticating users and admins
# Generate a secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=

# Resend API Key for sending booking confirmation emails
# Get yours from https://resend.com
RESEND_API_KEY=

# Optional: LiteAPI key for fetching hotel seed data (if running seed script)
VITE_LITEAPI_KEY=
